 * Cloudflare Pages looks for a file called "players/5/index.html" which
 * doesn't exist in a Vite SPA build.
 * This rule rewrites all routes to index.html so React Router handles them.
 */
/* index route */ / /index.html 200
/* SPA fallback */ /* /index.html 200

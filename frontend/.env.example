# ── Frontend Environment Variables ────────────────────────────────────────────
# Copy this file to .env.production and fill in the real values.
# .env.production is git-ignored — never commit real values.
#
# Backend API base URL (no trailing slash).
# Example: https://cod-tournament-api.onrender.com/api
VITE_API_URL=https://YOUR_BACKEND_URL_HERE/api

# Backend host for static file (image) URLs (no trailing slash).
# Same hostname as above, without the /api suffix.
# Example: https://cod-tournament-api.onrender.com
VITE_STATIC_URL=https://YOUR_BACKEND_URL_HERE

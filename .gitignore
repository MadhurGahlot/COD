# ==============================================================================
# Git Ignore Configuration - COD Tournament Platform
# ==============================================================================

# ── 1. Python & Bytecode ──────────────────────────────────────────────────────
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
*.egg
build/
dist/
*.manifest
*.spec

# ── 2. Virtual Environments ───────────────────────────────────────────────────
venv/
.venv/
env/
.env/
codenv/
codvenv/
*venv/
*env/
CODVENV/
*CODVENV/
ENV/
env.bak/
venv.bak/

# ── 3. Environment Secrets & Configs ──────────────────────────────────────────
# Strictly ignore secrets, but always track .env.example
.env
.env.*
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example
!frontend/.env.example

# ── 4. Node.js & Frontend Dependencies ────────────────────────────────────────
node_modules/
*/node_modules/
*/**/node_modules/
.npm/
.eslintcache
.vite/
frontend/.vite/
.turbo/
package-lock.json.tmp

# ── 5. Build & Distribution Outputs ───────────────────────────────────────────
frontend/dist/
frontend/dist-ssr/
frontend/build/
dist-ssr/

# ── 6. User Uploads & Media (Preserve structure via .gitkeep) ─────────────────
backend/static/player_photos/*
!backend/static/player_photos/.gitkeep

# ── 7. Databases & Local SQLite Storage ───────────────────────────────────────
*.sqlite
*.sqlite3
*.db
backend/*.db

# ── 8. Logs & Runtime Files ───────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock

# ── 9. IDEs, Editors & OS Metadata ────────────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.bak
*.tmp
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
* - Copy.*

# ── 10. Security & Secrets ────────────────────────────────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.json
secrets.yaml
secrets.yml
credentials.json

# ── 11. GitHub Actions local artifacts ───────────────────────────────────────
# (track workflow YAML but not runner artifacts)
.github/actions/*/node_modules/
.act/

# ── 12. Render / Deployment artifacts ────────────────────────────────────────
.render/
.render-buildpacks.json
render-*.log

# ── 13. Vercel artifacts ──────────────────────────────────────────────────────
.vercel/
.vercel-output/

# ── 14. Test & Coverage Reports ──────────────────────────────────────────────
test-results/
junit.xml
coverage.xml
*.lcov
reports/

# ── 15. Jupyter Notebooks checkpoints ────────────────────────────────────────
.ipynb_checkpoints/

# ── 16. Misc scratch / temp ───────────────────────────────────────────────────
*.orig
*.rej
scratch/
tmp/
temp/

